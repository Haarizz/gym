{
  "expo": {
    "name": "GymBios-Mobile",
    "slug": "GymBios-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "gymbiosmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "associatedDomains": [
        "applinks:TODO_PRODUCTION_DOMAIN"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D8078",
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anandu389.GymBiosMobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "TODO_PRODUCTION_DOMAIN",
              "pathPrefix": "/catalog/t/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#327f74"
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set profile pictures.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take profile pictures.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find gyms and wellness centers near you."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de134201-5eed-488d-8785-d6679aea3350"
      }
    },
    "owner": "anandu389"
  }
}
