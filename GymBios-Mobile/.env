#Development (Point to your local machine IP, e.g., 10.0.2.2 for Android emulator or localhost for iOS simulator)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.7:8080/api
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
# EXPO_PUBLIC_USE_MOCK_API=false

#Testing
EXPO_PUBLIC_API_BASE_URL=https://qa.gymbios.com/api
EXPO_PUBLIC_USE_MOCK_API=false

# Google Sign-In: public, non-secret OAuth client IDs (safe for Expo public env
# vars — the backend independently verifies the token's audience against its
# own oauth.google.client-ids allow-list). Never put a client *secret* or an
# Apple private key here. Fill in once Google Cloud Console registration is done.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=



# eas build --platform android --profile preview